# FileVault Application Environment
# Valid values: production, development, testing
APP_ENV=production

# Debug mode (true/false)
APP_DEBUG=false

# Application Base URL
APP_URL=https://filevault.example.com

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=filevault
DB_USERNAME=root
DB_PASSWORD=

# Storage Configuration
STORAGE_ROOT=/var/www/filevault/storage

# Admin UI Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

