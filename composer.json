{
    "name": "filevault/core",
    "description": "FileVault Core Foundation",
    "type": "project",
    "require": {
        "php": ">=8.2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FileVault\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FileVault\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false,
        "disable-tls": true,
        "secure-http": false
    }
}
